datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  PROCUREMENT_OFFICER
  MANAGER
  VENDOR
}

enum VendorStatus {
  ACTIVE
  PENDING
  INACTIVE
  BLOCKED
}

enum RFQStatus {
  DRAFT
  SENT
  CLOSED
  CANCELLED
}

enum QuotationStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum POStatus {
  GENERATED
  CONFIRMED
  DELIVERED
  CANCELLED
}

enum InvoiceStatus {
  PENDING
  SENT
  PAID
  OVERDUE
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  firstName    String
  lastName     String
  role         Role
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  rfqs         RFQ[]         @relation("RFQCreatedBy")
  approvals    Approval[]
  purchaseOrders PurchaseOrder[] @relation("POCreatedBy")
  notifications Notification[]
  activityLogs ActivityLog[]
  attachments  Attachment[]
}

model Vendor {
  id            String       @id @default(cuid())
  companyName   String
  category      String       // E.g. IT, Construction, etc.
  gstNumber     String       @unique
  contactEmail  String
  contactPhone  String
  address       String
  status        VendorStatus @default(PENDING)
  riskScore     String       @default("Medium") // Low, Medium, High
  rating        Float        @default(0.0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  rfqVendors    RFQVendor[]
  quotations    Quotation[]
  purchaseOrders PurchaseOrder[]
  invoices      Invoice[]
}

model RFQ {
  id             String       @id @default(cuid())
  rfqNumber      String       @unique // E.g. RFQ-2026-0001
  title          String
  description    String
  budget         Float
  deadline       DateTime
  status         RFQStatus    @default(DRAFT)
  createdById    String
  createdBy      User         @relation("RFQCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  items          RFQItem[]
  rfqVendors     RFQVendor[]
  quotations     Quotation[]
  attachments    Attachment[]
}

model RFQItem {
  id            String    @id @default(cuid())
  rfqId         String
  rfq           RFQ       @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  itemName      String
  quantity      Float
  unit          String    // E.g. Units, kg, hrs
  estimatedCost Float
}

model RFQVendor {
  id        String   @id @default(cuid())
  rfqId     String
  rfq       RFQ      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  invitedAt DateTime @default(now())
}

model Quotation {
  id              String          @id @default(cuid())
  quotationNumber String          @unique // E.g. QT-2026-0001
  rfqId           String
  rfq             RFQ             @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendorId        String
  vendor          Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  status          QuotationStatus @default(SUBMITTED)
  subtotal        Float
  gstPercent      Float           @default(18.0)
  grandTotal      Float
  paymentTerms    String
  warranty        String
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  items           QuotationItem[]
  approvals       Approval[]
  purchaseOrders  PurchaseOrder[]
}

model QuotationItem {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  itemName    String
  quantity    Float
  unitPrice   Float
  total       Float
  deliveryDays Int
}

model Approval {
  id          String         @id @default(cuid())
  quotationId String
  quotation   Quotation      @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  managerId   String
  manager     User           @relation(fields: [managerId], references: [id])
  status      ApprovalStatus @default(PENDING)
  remarks     String?
  approvedAt  DateTime?
  createdAt   DateTime       @default(now())
}

model PurchaseOrder {
  id          String        @id @default(cuid())
  poNumber    String        @unique // E.g. PO-2026-0001
  quotationId String
  quotation   Quotation     @relation(fields: [quotationId], references: [id])
  vendorId    String
  vendor      Vendor        @relation(fields: [vendorId], references: [id])
  createdById String
  createdBy   User          @relation("POCreatedBy", fields: [createdById], references: [id])
  totalAmount Float
  status      POStatus      @default(GENERATED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  invoices    Invoice[]
}

model Invoice {
  id              String        @id @default(cuid())
  invoiceNumber   String        @unique // E.g. INV-2026-0001
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  vendorId        String
  vendor          Vendor        @relation(fields: [vendorId], references: [id])
  subtotal        Float
  taxAmount       Float
  grandTotal      Float
  status          InvoiceStatus @default(PENDING)
  dueDate         DateTime
  pdfUrl          String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String   // E.g. LOGIN, CREATE_RFQ, etc.
  description String
  createdAt   DateTime @default(now())
}

model Attachment {
  id        String   @id @default(cuid())
  rfqId     String?
  rfq       RFQ?     @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName  String
  fileUrl   String
  fileSize  Int      // in bytes
  createdAt DateTime @default(now())
}
